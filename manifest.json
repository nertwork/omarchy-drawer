{
  "schemaVersion": 1,
  "id": "nertwork.drawer",
  "name": "Bar Drawer",
  "version": "1.0.0",
  "author": "nertwork",
  "license": "MIT",
  "description": "Foldable drawer container for Omarchy status bar widgets with smooth expand/collapse animations.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Bar Drawer",
    "description": "Foldable drawer container for Omarchy status bar widgets",
    "category": "Appearance",
    "aliases": [
      "drawer",
      "foldable-drawer",
      "container"
    ],
    "defaultSection": "right",
    "allowMultiple": true,
    "defaults": {
      "items": [
        "omarchy.tailscale",
        "nertwork.agents",
        "omarchy.bluetooth",
        "omarchy.network",
        "omarchy.microphone"
      ],
      "defaultExpanded": false,
      "chevronPosition": "left",
      "animationDuration": 350
    }
  },
  "repository": "https://github.com/nertwork/omarchy-drawer"
}
